# Copie para .env e preencha. Nunca publique este arquivo com as chaves.

# ---- Pesquisa no Google (preencha pelo menos uma opção) ----
# SerpAPI (resultados do Google) - https://serpapi.com
SERPAPI_KEY=
# Google Programmable Search JSON API - https://developers.google.com/custom-search
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---- IA (Claude) - análise de fabricantes, reputação e referências ambíguas ----
ANTHROPIC_API_KEY=
# Modelo e esforço (low | medium | high). Esforço menor = menos tokens.
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ---- Opcionais ----
# DB_PATH=data/buscador.db
# USER_AGENT=BuscadorAutopecas/1.0 (+contato)
