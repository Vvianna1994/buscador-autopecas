# Copie para .env (ou exporte no shell) e preencha o que tiver.

# Google Shopping via SerpAPI (agrega centenas de lojas) - https://serpapi.com
SERPAPI_KEY=

# Token OAuth do Mercado Livre (a API de busca exige token) - https://developers.mercadolivre.com.br
ML_ACCESS_TOKEN=

# 1 = inclui a fonte de demonstração (dados fictícios) mesmo com fontes reais ativas
DEMO_MODE=0
